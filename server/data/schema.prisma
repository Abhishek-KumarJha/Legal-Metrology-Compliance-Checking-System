generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) name String role String email String @unique passwordHash String orgId String? inspections Inspection[] }
model Company { id String @id @default(cuid()) name String licenseNumber String? address String? gstNumber String? products Product[] }
model Product { id String @id @default(cuid()) companyId String company Company @relation(fields: [companyId], references: [id]) name String category String imageUrls String[] inspections Inspection[] }
model Inspection { id String @id @default(cuid()) productId String? product Product? @relation(fields: [productId], references: [id]) officerId String? officer User? @relation(fields: [officerId], references: [id]) images String[] ocrRawText String status String createdAt DateTime @default(now()) checks DeclarationCheck[] report Report? }
model DeclarationCheck { id String @id @default(cuid()) inspectionId String inspection Inspection @relation(fields: [inspectionId], references: [id]) fieldName String detectedValue String? isCompliant Boolean ruleSection String confidenceNote String }
model Report { id String @id @default(cuid()) inspectionId String @unique inspection Inspection @relation(fields: [inspectionId], references: [id]) pdfUrl String? generatedAt DateTime @default(now()) }
model RulesConfig { id String @id @default(cuid()) fieldName String regexPattern String minFontSizeMm Float ruleSectionReference String isActive Boolean @default(true) }
